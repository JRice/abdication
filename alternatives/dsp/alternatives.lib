// alternatives.lib: brief, stochastic bumps and holes in the spectrum of
// whatever comes in, on the harmonics of the notes being played. Abdication's
// Events (its texture.lib), as an effect: the same slots, walks and leveler,
// now on a stereo signal (both channels get the same bumps, so the image
// stays put), with each bump landing on a harmonic of one of up to eight
// notes, and the constants Abdication kept fixed opened as controls.
//
// Every random value is a hash of one integer stream per instance, so extra
// slots add no noise generators.

import("stdfaust.lib");

//------------------------------------------------------------------ randomness

stream(seed) = (+(int(seed) * (1 - 1')) : *(1103515245) : +(12345)) ~ _;
hash(x)      = (x xor (x >> 15)) * 1664525 : \(y).((y xor (y >> 13)) * 1013904223);
bi(x)        = float(hash(x)) / 2147483648.0;  // -1..1
uni(x)       = 0.5 + 0.5 * bi(x);              //  0..1

//------------------------------------------------------------------ cheap math

clip(lo, hi) = max(lo) : min(hi);

// 2^x, within about 2e-6. Exactly 1 at x = 0, which keeps an idle slot a bypass.
exp2(x) = poly * float(1 << clip(0, 30, n)) / float(1 << clip(0, 30, 0 - n))
with {
    n = int(floor(x));
    t = x - floor(x);
    poly = 1 + t * (0.693147 + t * (0.240227 + t * (0.0555041 + t * (0.0096181 + t * 0.0013333))));
};

// 0..1 -> an exponentially distributed value with mean near 1. The rational form
// of -ln(u) tops out near 3.6 rather than running off to a rare very long gap.
expDraw(u) = 2 * z * (15 - 4 * z2) / (15 - 9 * z2)
with { z = (1 - u) / (1 + u); z2 = z * z; };

// tan(x) to 0.1% up to x = 1.41 (0.45 of the sample rate).
tanFast(x) = x * (105 - 10 * x2) / (105 - 45 * x2 + x2 * x2) with { x2 = x * x; };

log2(x)     = log(x) / log(2);
bell(p)     = 16 * w * w with { w = p * (1 - p); };  // exactly 0 at p = 0 and 1
offBelow(x) = x * (x > 1e-4);                        // smoothed controls never reach 0

// x while c is true, else 0, computing x only while c is true.
only(c) = enable(_, c) : *(c != 0);

// A smooth random value, -1..1, moving to a new target about rate times a second.
wander(seed, rate) = target : si.smooth(exp(-2 * rate / ma.SR))
with {
    tick = (+(rate / ma.SR) : ma.frac) ~ _ : \(p).(p < p');
    target = ba.sAndH(tick | ((1 - 1') > 0), bi(stream(seed)));
};

//------------------------------------------------------------------ filter

// Zero-delay state-variable bandpass, unity at the center and stable under fast
// modulation. Topology-preserving form (Zavalishin, Simper).
bandpass(f, k) = core ~ (_, _) : !, !, _
with {
    g  = tanFast(ma.PI * f / ma.SR);
    a1 = 1 / (1 + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;
    core(s1, s2, x) = 2 * v1 - s1, 2 * v2 - s2, k * v1
    with {
        v3 = x - s2;
        v1 = a1 * s1 + a2 * v3;
        v2 = s2 + a2 * s1 + a3 * v3;
    };
};

//------------------------------------------------------------------ alternatives

// Up to maxSlots slots, chained rather than summed so that overlapping cuts only
// get deeper: a sum could pass through zero and invert the partial. A slow
// leveler (when hold is on) keeps each channel's average level, so switching it
// on or moving a control doesn't change loudness, which would sound like an
// improvement in its own right. Stereo in, stereo out.
//
//   notes    maxNotes frequencies in Hz, of which the first `count` are in play:
//            each bump picks one of them as it starts
//   slots    how many slots run, 1..maxSlots (the rest pass the signal untouched,
//            and aren't computed)
//   busy     share of the time each slot is in a bump, 0..1
//   depth    height of a bump in dB
//   reach    highest harmonic a bump starts on (weighted toward the low ones)
//   life     lifetime scale: 1 is about 400 ms at 300 Hz down to 40 ms at 9 kHz
//   walk     0 a still bell; 1 wanders in gain and frequency, and can turn a bump over
//   sharp    bandwidth scale: above 1 is narrower, and toward a vocoder at high depth
//   cut      how much deeper a turned-over bump cuts than it boosts
//   hold     1 holds the average level, 0 lets the bumps move it
maxSlots = 12;
maxNotes = 8;

alternatives(seed, notes, count, slots, busy, depth, reach, life, walk, sharp, cut, hold) =
    _, _ <: chain, _, _ : route(4, 4, (1, 1), (2, 3), (3, 2), (4, 4)) : held, held
with {
    capped  = min(busy, 0.98);
    gapRate = capped / (1 - capped);  // gaps measured in lifetimes
    chain = seq(i, maxSlots, slot(i, stream(seed), notes, count, i < slots, gapRate, offBelow(depth),
                                 reach, life, walk, sharp, cut));
    held(out, in) = select2(hold, out, leveled(out, in));
};

// Exactly unity when out and in are identical, so a bypass stays a bypass.
leveled(out, in) = out * sqrt((power(in) + 1e-9) / (power(out) + 1e-9))
with { power = \(x).(x * x) : si.smooth(exp(-1 / (levelerTime * ma.SR))); };

levelerTime = 3;    // seconds: much longer than a bump, so bumps still move the level
bumpQ     = 1.5;
baseLife  = 0.4;    // seconds at 300 Hz and below
tickTime  = 0.024;  // seconds between steps of a walk
walkStep  = 0.35;   // size of each step
walkWidths = 2;     // bandwidths of frequency per unit of walk, at walk = 1
walkMaxOct = 0.75;  // keeps a wide bump from wandering off across the spectrum
dbPerOct  = 6.0206; // dB in a doubling of amplitude

// One slot, on both channels: the same bump (centre, width, gain) on each.
slot(i, r, notes, count, on, gapRate, depth, reach, life, walk, sharp, cut) = par(c, 2, peak)
with {
    draw(k)  = r + (i * 97 + k) * 7919;

    // Each slot's clock is a single value: negative counts down a gap, 0..1 is
    // the event. The rate acts on the remaining gap, so turning up Density from
    // zero answers at once rather than after a long stale wait.
    gapDraw  = 0 - expDraw(uni(draw(2)));

    // The note this bump is on: one of those in play, picked in the gap.
    which     = int(clip(0, count - 1, floor(uni(draw(9)) * count)));
    candidate = notes : ba.selectn(maxNotes, which);
    // Octaves above the note, stopping short of the top of the audio range on high
    // notes, where bumps would otherwise pile up doing nothing.
    aboveOctOf(n) = uni(draw(0)) * log2(clip(1, reach, 0.45 * ma.SR / n));
    heightOf(n)   = clip(0, 1, (log2(n) + aboveOctOf(n) - log2(300)) / log2(30));  // 300 Hz..9 kHz
    lifeOf(n)     = max(0.005, life * baseLife * exp2(uni(draw(1)) - 0.5 - heightOf(n) * log2(10)));

    // The clock, carrying the note: it follows the candidate through a gap and
    // keeps it through the bump (the bump's life depends on it).
    clock = step ~ (_, _)
    with {
        step(prev, held) = select2(ends, prev + inc, enable(gapDraw, ends)), note
        with {
            first = (1 - 1') > 0;
            ends = (prev >= 1) | first;
            waiting = prev < 0;
            note = select2(waiting | first, held, candidate);
            eventLife = max(ba.sAndH(waiting, lifeOf(note)), 0.005);
            inc = select2(waiting, 1, gapRate) / (eventLife * ma.SR);
        };
    };
    phase = clock : _, !;
    note  = clock : !, _;
    harmonic = rint(exp2(aboveOctOf(note)));
    lifeDraw = lifeOf(note);

    active = phase >= 0;
    // Follows a draw through the gap, then freezes. The draws are only read
    // in a gap, so they're only computed then.
    hold(x) = ba.sAndH(gap, enable(x, gap)) with { gap = phase' < 0; };
    p      = clip(0, 1, phase);
    window = bell(p);

    bias = hold(0.5 + 0.5 * uni(draw(4)));
    k    = 1 / (sharp * bumpQ);

    // Random walks from zero: a step every tick, reset between bumps.
    ticks = floor(p * hold(lifeDraw) / tickTime);
    tick  = ticks != ticks';
    walker(salt) = (+(tick * walkStep * enable(bi(draw(salt)), tick)) : *(active)) ~ _
                 : si.smooth(exp(-2 / (tickTime * ma.SR)));

    // Measured in bandwidths, so a narrow bump stays near the partial it landed on.
    bandwidthOct = 1.44 * k;
    walkRange = min(walkWidths * bandwidthOct, walkMaxOct);
    f = note * hold(harmonic) * exp2(walk * walkRange * walker(5)) : clip(20, 0.45 * ma.SR);
    v = clip(-1, 1, bias + walk * walker(6));
    gainDb = select2(v < 0, depth, depth * cut) * v * window;
    bump = exp2(gainDb / dbPerOct) - 1;

    // An unused slot passes its input untouched and computes nothing.
    peak = _ <: _, (bandpass(f, k) : *(bump) : only(on)) :> _;
};
