//==========================================================================
// fdsp.lib — note-dependent processors for a voice, after the Yamaha EX5's
// FDSP: an effect stage per voice whose delays and filters are tuned to the
// note, so a flanger or a resonator becomes part of the timbre. The ideas
// are borrowed, not the specifics (the EX5's algorithms aren't published).
//
//   water    a resonator tuned to the note: a feedback delay with a lowpass
//            in its loop (a struck string or tube), its length wobbling a
//            little at random, so the ringing wavers like light on water
//   tornado  the voice phase-modulates itself through a short delay (its
//            own signal moves where it's read from), with feedback and a
//            ceiling on how fast the modulation can move, then a drive
//   flange   a feedback comb whose length is a fraction of the note's period
//   phase    a chain of allpasses centred on a pitch relative to the note
//
// Each takes the voice (mono) and its pitch in Hz, and gives back the wet
// signal blended with the dry by its Mix. No controls here: voice.lib owns
// them. All four start up dry and crossfade in once their delay holds the
// new note (see `fresh`), so a voice reused from silence never plays a
// stale tail from its last note.
//==========================================================================

import("stdfaust.lib");
te = library("texture.lib");

// Longest delay, in samples: 5.9 Hz at 48 kHz, 11.7 Hz at 96 kHz.
maxDelay = 8192;
shortest = 3;                  // Lagrange-3 needs a little room
period(hz) = ma.SR / max(hz, 1);
clampDelay = max(shortest) : min(maxDelay - 4);

// The dry signal, then a crossfade to `wet` (already blended) once the
// note's first `len` samples have passed, over 2 ms.
//   since:  samples since note-on
fresh(since, len) = te.clip(0, 1, (since - len) / (0.002 * ma.SR));
startUp(since, len, dry, wet) = dry + fresh(since, len) * (wet - dry);
starting(since, len) = fresh(since, len) < 1;

// Samples since the latest note-on (noteOn is 1 for its first sample).
sinceNoteOn(noteOn) = (+(1) : *(1 - noteOn)) ~ _;

blend(mix, dry, wet) = dry + mix * (wet - dry);

// The two levellers below compare `out` with `in` by their average power
// over a few tenths of a second. Both hold still (`hold` 1) while a note
// starts up (see `fresh`): what goes on then isn't the effect at its
// settings, and following it would swell the start of every note.
power(hold, secs) = \(s).(s * s) : si.smooth(select2(hold, exp(-1 / (secs * ma.SR)), 1));
gainFor(hold, secs, in, out) = sqrt((power(hold, secs, in) + 1e-9) / (power(hold, secs, out) + 1e-9));

// `out`, raised toward `in`'s level by up to maxDb, never lowered: so when
// the input stops, a ringing tail dies away as it would, instead of being
// pulled down with it.
lifted(maxDb, hold, in, out) = out * te.clip(1, ba.db2linear(maxDb), gainFor(hold, 0.5, in, out));

// `out` held at `in`'s level, within maxDb either way.
matched(maxDb, hold, in, out) = out * te.clip(ba.db2linear(-maxDb), ba.db2linear(maxDb), gainFor(hold, 0.25, in, out));

//------------------------------------------------------------------ water

// A one-pole lowpass's phase delay in samples at w radians per sample (its
// pole at a): the loop is shortened by this much so it stays in tune.
lpDelay(a, w) = atan(a * sin(w) / (1 - a * cos(w))) / w;

wobbleCents = 40;              // at full Wobble, either way
waterLift   = 24;              // dB: the most `lifted` adds
wobbleRates = (3.3, 9.7);      // Hz: a slow waver and a quicker shimmer

// Inputs: the voice, its pitch, then Pitch (semitones from the note), Ring
// (0..1: ringing 20 ms to 12 s), Damp (0..1: bright to dark), Wobble
// (0..1), Mix, samples since note-on and a seed for this voice.
water(x, hz, pitch, ring, damp, wobble, mix, since, seed) =
    startUp(since, len, x, blend(mix, x, wet))
with {
    drift = 0.7 * te.wander(seed, ba.take(1, wobbleRates)) + 0.3 * te.wander(seed + 1, ba.take(2, wobbleRates));
    fres  = hz * te.exp2(pitch / 12 + wobble * wobbleCents * drift / 1200) : min(0.4 * ma.SR);
    len   = period(fres);
    // The loop's lowpass: from 90 harmonics of the resonance down to 1.5.
    fd    = fres * te.exp2(6.5 - 5.9 * damp) : min(0.45 * ma.SR);
    a     = exp(-2 * ma.PI * fd / ma.SR);
    w0    = 2 * ma.PI * fres / ma.SR;
    t60   = te.expLerp(0.02, 12, ring);
    g     = ba.db2linear(-60 * len / (t60 * ma.SR)) * fresh(since, len);
    // The ~ adds a sample: the delay is the loop's length less that and the lowpass's lag.
    d     = len - 1 - lpDelay(a, w0) : clampDelay;
    loop  = + ~ (de.fdelay3(maxDelay, d) : fi.pole(a) : *(1 - a) : *(g));
    // Its peaks reach 1 / (1 - g |H|), H the loop's lowpass at the resonance:
    // scaled by that, a note at the resonance comes out as loud as it went
    // in. Anything off the peaks (noise, a wobbling resonance, another pitch)
    // comes out quieter, and `lifted` brings it back up toward the input's level.
    hAt   = (1 - a) / sqrt(1 - 2 * a * cos(w0) + a * a);
    wet   = x : loop : *(1 - g * hAt) : fi.dcblocker : lifted(waterLift, starting(since, len), x);
};

//------------------------------------------------------------------ tornado

tornadoMatch = 12;             // dB, either way: the most `matched` changes the level

// Inputs: the voice, its pitch, then Drive, Overtone (how far it moves its
// own reading point: up to a period of the note), Ceiling (how fast that can move:
// 1 to 32 harmonics of the note), Edge (output fed back into the
// movement), Mix, samples since note-on.
tornado(x, hz, drive, overtone, ceiling, edge, mix, since) =
    startUp(since, len, x, blend(mix, x, wet))
with {
    len   = period(hz) + shortest;
    depth = 0.5 * overtone * overtone * period(hz);
    fc    = hz * te.exp2(5 * ceiling) : min(0.4 * ma.SR);
    fb    = 2.5 * edge * fresh(since, len);
    // y' is the last output: Edge feeds it into the movement.
    moved(yPrev, in) = in : de.fdelay3(maxDelay, d)
    with {
        m = ma.tanh(2.5 * (in + fb * yPrev)) : fi.lowpass(2, fc);
        d = shortest + depth * (1 + m) : clampDelay;
    };
    gain  = te.exp2(4 * drive);                // 1..16
    shape = \(s).(ma.tanh(gain * s) / gain);
    // Unity for small signals; squashed peaks lose level, and `matched` gives it back.
    wet   = x : (moved ~ _) : shape : matched(tornadoMatch, starting(since, len), x);
};

//------------------------------------------------------------------ flange

// Feedback piles up the peaks (or the notches). The wet side is scaled for
// noise's power (sqrt(1 - fb^2)), then held at the dry's level, so Feedback
// changes the colour, not the loudness.
combMatch = 12;                // dB, either way

// Inputs: the voice, its pitch, then Pitch (the comb's own pitch, in
// semitones from the note: 0 matches the note, so a steady note passes
// untouched; 12 cancels its odd harmonics), Feedback (-1..1), Mix, samples
// since note-on.
flange(x, hz, pitch, feedback, mix, since) =
    startUp(since, len, x, blend(mix, x, wet))
with {
    len = period(hz * te.exp2(pitch / 12)) : clampDelay;
    fb  = feedback * fresh(since, len);
    // v = x + fb * v delayed (the ~ adds the loop's last sample); the wet side is v delayed.
    v   = x : (+ ~ (de.fdelay3(maxDelay, len - 1) : *(fb)));
    wet = v : de.fdelay3(maxDelay, len) : *(sqrt(1 - fb * fb)) : matched(combMatch, starting(since, len), x);
};

//------------------------------------------------------------------ phase

// A first-order allpass at fc Hz.
allpass(fc) = fi.tf1(c, 1, c) with { t = tan(ma.PI * min(fc, 0.45 * ma.SR) / ma.SR); c = (t - 1) / (t + 1); };

// Twelve allpasses in a row, tapped after every second one: six outputs.
taps(fc, 1) = allpass(fc) : allpass(fc);
taps(fc, n) = allpass(fc) : allpass(fc) <: _, taps(fc, n - 1);

// Inputs: the voice, its pitch, then Pitch (semitones from the note), Feedback
// (-1..1), Stages (0..5: 2, 4, ... 12 allpasses), Mix, samples since note-on.
phase(x, hz, pitch, feedback, stages, mix, since) =
    startUp(since, len, x, blend(mix, x, wet))
with {
    fc  = hz * te.exp2(pitch / 12);
    len = period(hz);
    fb  = feedback * fresh(since, len);
    // y = the chain (Stages long) of x + fb * y'.
    chain(yPrev, in) = in + fb * yPrev : taps(fc, 6) : ba.selectn(6, int(stages));
    wet = x : (chain ~ _) : *(sqrt(1 - fb * fb)) : matched(combMatch, starting(since, len), x);
};
