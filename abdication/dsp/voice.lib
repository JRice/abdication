//==========================================================================
// voice.lib — the instrument voice: engines and core blocks wired
// together with controls attached. One module per panel.
//
//   Osc 1, Osc 2 (each a Dual or a Wavetable), noise -> normalized mixer
//     tonal (mixer saturation) (+ transient, if pre-filter) -> drive
//     -> filter -> soft clip -> HPF
//     -> amp envelope (+ transient, if post-filter); noise skips the drive
//==========================================================================

import("stdfaust.lib");
ds = library("core.lib");
eng = library("engines.lib");
wl = library("wavelib.lib");
tl = library("translib.lib");
te = library("texture.lib");

// ---- The parts of a voice --------------------------------------------------
// The plugin runs each voice as three kinds of Faust DSP, all built from
// this file:
//   plugin-osc.dsp    one unison copy of the Dual and Wavetable: seven per
//                     voice with Unison on, one (the centre) with it off
//   plugin-voice.dsp  everything else, taking the copies' sum as inputs
//   plugin-texture.dsp  the voice's events and calls, on its output (skipped
//                     while both are off, which is what keeps them apart)
// Splitting them keeps the Faust compiler's job small and the plugin
// computes only the copies that sound.
//
// The modulators (an LFO and an envelope per knob, plus velocity,
// aftertouch, mod wheel and key) live in the plugin (modulation.rs), not
// here: it moves each knob per voice once a block, and the voice takes the
// result as that control's value (see `ramped`).
//
// parts(...) is every definition of a voice. Its arguments: the note
// (freq, gain, gate, a random seed per note, this note's portamento time
// in seconds, 0 for none) and (for the voice) the summed Dual and
// Wavetable copies.
panelTaps = 7;

// One voice without its two oscillators, which arrive (their unison copies
// summed) as osc1In, osc2In. Outputs: the voice; then, for the panel, the
// moving values: the filter (cutoff, resonance, morph, bandpass, utility HPF);
// then, for plugin-texture.dsp, its pitch and amp envelope.
voice(freq, gain, gate, seed, glide, osc1In, osc2In) =
    parts(freq, gain, gate, seed, glide, osc1In, osc2In).out;

// Unison copy `copy` (0..6, 3 the centre) of a voice's two oscillators.
// Outputs: Osc 1 and Osc 2 at their unison level (to be summed), then as
// they are (the centre copy's are the panel's scopes).
unisonCopy(freq, gate, seed, glide, copy) =
    parts(freq, 1, gate, seed, glide, 0, 0).copy(copy);

// A voice's texture (texture.lib). Inputs: its output, pitch and amp envelope.
// Outputs: the voice with its events, then its calls, left and right.
texture(gate, in, hz, amp) =
    parts(110, 1, gate, 0, 0, 0, 0).textureOut(in, hz, amp);

parts(freq0, gain, gate, seed, glide, osc1In, osc2In) = environment {

    // Control smoothing (as si.smoo) that snaps to its target on note-on. The
    // plugin only computes voices that are playing, so an idle voice's
    // smoothers go stale; without the snap, a new note would glide from old
    // values for ~20 ms and swallow fast transients. `noteOn` reads the
    // entry point's gate: the same button("gate") signal, so it must stay
    // declared with exactly this label there.
    noteOn = button("gate") <: _ > _';
    smooth = si.smooth((1 - 44.1 / ma.SR) * (1 - noteOn));

    // A modulated control: the plugin sets it once a block, per voice, to the
    // knob as its modulators have moved it. This draws a straight line to
    // each new value over `ramp` samples (the block's length, set by the
    // plugin), so a block-rate envelope plays as a smooth curve, not steps;
    // on note-on it jumps straight there.
    rampLen = hslider("ramp", 64, 1, 4096, 1);
    ramped(x) = state ~ (_, _) : !, _
    with {
        state(t, c) = nt, nc
        with {
            nt = select2((x != x') | noteOn, t - 1, rampLen);
            nc = select2(noteOn, select2(nt > 0, x, c + (x - c) / max(1, nt)), x);
        };
    };

    // x computed only while c is true, else 0 (core.lib's only).
    enabled(x, c) = x : ds.only(c);

    // ---- Vintage -------------------------------------------------------------
    // One knob of analogue imperfection, after Sequential's Vintage knob and
    // u-he Diva's trimmers: each voice gets its own stable offsets, as if its
    // parts were slightly out of tolerance (tuning, cutoff, envelope times),
    // and its pitch drifts slowly. Near the top a
    // tape-style wow and flutter come in (they grow with the square of the
    // knob, so the low end stays subtle). Each voice also has two noises of its
    // own, growing in step with the knob: one on its pitch, one on its level.
    // A fast pitch noise barely touches the low partials and blurs the high
    // ones, since a partial's deviation in Hz grows with its number.
    vintageNoiseFmCents = 3;     // RMS at full Vintage
    vintageNoiseFmHz    = 60;    // the noise's lowpass
    vintageNoiseAmDb    = 0.7;   // RMS at full Vintage
    vintageNoiseAmHz    = 25;    // the noise's lowpass
    vintage = vintageP(hslider("[1]Amount", 0, 0, 1, 0.001)) : ramped;
    vintageP(x) = hgroup("[0.5]Vintage", x);
    // This voice's identity, set once per voice by the plugin engine.
    voiceSlot = hslider("slot", 0, 0, 64, 1);
    // A stable random value in -1..1 for this voice and key k.
    hash(k) = 2 * ma.frac(sin(voiceSlot * 12.9898 + k * 78.233) * 43758.5453) - 1;
    // Its traits are correlated, as on GForce's OB-X: each voice has two
    // stable identity values, and each trait mixes them with its own signs
    // and weights (traitW1, traitW2), plus a part of its own. So a voice
    // that runs sharp also tends to be brighter and quicker, and keeps that
    // personality as Vintage scales it. The mix is normalized to the spread
    // of a single random value, then held to -1..1.
    //   k: 1 tuning, 2 drift rate, 3 wow rate, 4 cutoff, 5 cutoff jitter rate,
    //      6 attack, 7 decay, 8 release (9..13 unused: they were the
    //      Fundamental's pulse width and the old LFO rates)
    traitW1 = (0.7, 0.0, 0.0, 0.6, 0.0, -0.3, -0.4, -0.4, 0.5, 0.4, 0.0, 0.0, 0.4);
    traitW2 = (0.3, 0.6, 0.5, -0.4, 0.3, 0.6, 0.5, 0.5, 0.0, 0.4, 0.0, 0.0, -0.4);
    traitOwn = 0.5;
    trait(k) = ds.clamp(-1, 1, (w1 * hash(101) + w2 * hash(102) + traitOwn * hash(k))
                               / sqrt(w1 * w1 + w2 * w2 + traitOwn * traitOwn))
    with { w1 = ba.take(k, traitW1); w2 = ba.take(k, traitW2); };
    // x varied by up to +-pct (at full Vintage), per voice, for trait k.
    vary(k, pct, x) = x * (1 + vintage * pct * trait(k));
    // Its noises and LFOs aren't computed while Vintage is at 0 (once the
    // knob's smoothing has settled there).
    vintageOn = abs(vintage) > 1e-4;
    vintageCents = enabled(vintage * (8 * trait(1) + 10 * drift + vintageNoiseFmCents * vintageNoise * noiseFm)
                          + vintage ^ 2 * (18 * wow + 2 * flutter), vintageOn)
    with {
        noiseFm = te.colored(4000 + 409 * voiceSlot, vintageNoiseFmHz);
        drift   = 2 * ds.jitter(0.25 + 0.15 * trait(2));    // slow, per voice
        wow     = os.osc(0.45 + 0.1 * trait(3));
        flutter = os.osc(6.5);
    };
    vintageGain = te.exp2(enabled(vintage * vintageNoise * vintageNoiseAmDb * te.colored(5000 + 521 * voiceSlot, vintageNoiseAmHz)
                                 / 6.0206, vintageOn));
    vintageCutoff = ds.exp2(enabled(vintage * (0.25 * trait(4) + 0.1 * ds.jitter(0.2 + 0.1 * trait(5))), vintageOn));

    // ---- Panels ------------------------------------------------------------
    uniP(x)   = hgroup("[1.5]Unison", x);
    // Two oscillator slots, each a Dual or a Wavetable (its Mode): the slot's
    // own controls, then each engine's (both kept, whichever plays).
    osc1P(x)  = hgroup("[2]Osc 1", x);
    dual1P(x) = hgroup("[2.1]Dual 1", x);
    wt1P(x)   = hgroup("[2.2]WT 1", x);
    osc2P(x)  = hgroup("[3]Osc 2", x);
    dual2P(x) = hgroup("[3.1]Dual 2", x);
    wt2P(x)   = hgroup("[3.2]WT 2", x);
    ray1P(x)  = hgroup("[2.3]Ray 1", x);
    ray2P(x)  = hgroup("[3.3]Ray 2", x);
    noiseP(x) = hgroup("[4]Noise", x);
    transP(x) = hgroup("[5]Transient", x);
    mixP(x)   = hgroup("[6]Mix", x);
    driveP(x) = hgroup("[7]Drive", x);
    filtP(x)  = hgroup("[8]Filter", x);
    envP(x)   = hgroup("[9]Amp", x);
    perfP(x)  = hgroup("[10]Perform", x);
    masterP(x) = hgroup("[0]Master", x);
    eventsP(x) = hgroup("[11]Events", x);
    callsP(x)  = hgroup("[12]Calls", x);
    // Under-the-hood settings (the panel's ☰ menu).
    settingsP(x) = hgroup("[13]Settings", x);
    // How much of the drive's random bias (its built-in grit, a noise floor
    // even with the drive at 0) and of Vintage's noise wobble get through.
    driveGrit    = settingsP(hslider("[0]Drive Grit", 1, 0, 1, 0.01)) : smooth;
    vintageNoise = settingsP(hslider("[1]Vintage Noise", 1, 0, 1, 0.01)) : smooth;
    // How hard the oscillators drive the mixer's saturation and the filter
    // the clipper after it (core.lib's mixerHeat, postClip): 1 is
    // Shibboleth's level, 0 the clean path from before.
    heat         = settingsP(hslider("[2]Heat", 1, 0, 2, 0.01)) : smooth;

    // ---- Performance controls ----------------------------------------------
    // Driven by the plugin engine from MIDI (and by the web IDE's MIDI, via
    // the metadata). Not a host parameter. (Velocity, aftertouch, the mod
    // wheel and the key reach the knobs through their modulators, in the plugin.)
    bend       = hslider("bend [midi:pitchwheel] [hidden:1]", 0, -1, 1, 0.0001) : smooth;

    // Every voice's pitch, +-1 octave: a modulatable knob like the others
    // (its modulator starts as vibrato on the mod wheel: see params.rs).
    globalPitch = perfP(hslider("[1]Global Pitch [unit:st]", 0, -12, 12, 0.01)) : ramped;

    // Pitch bend has one job at a time:
    //   0 +-2 semitones  1 +-1 octave  2 cutoff +-50 %  3 resonance +-50 %
    //   4 bandpass +-50 %   (the non-pitch modes leave pitch alone)
    bendMode = perfP(nentry("[5]Bend Mode [style:menu{'2 Semitones':0;'Octave':1;'Cutoff 50%':2;'Resonance 50%':3;'Bandpass 50%':4}]", 0, 0, 4, 1));
    bendTo(m) = bend * (bendMode == m);

    pitchSemis = 2 * bendTo(0) + 12 * bendTo(1) + globalPitch + vintageCents / 100;

    // ---- The oscillators -------------------------------------------------------
    // Each slot plays a Dual or a Wavetable (its Mode; only that one is
    // computed), an octave or two up or down.
    // Every function here takes its panels' groups (S the slot's, D its
    // Dual's, W its Wavetable's), so the two slots share one definition.
    // Each unison copy (its own DSP) calls each slot once.
    // Mode Ray (2) is played by the plugin (ray/, in Rust): here the slot is
    // silent, and `slotHz` tells the plugin the pitch to play it at.
    slot(S, D, W, mode0, freq, rst, off) = (dual(D, f, rst, off), wavetable(W, f, rst, off)) : ds.choose(2, slotMode(S, mode0))
    with { f = slotHz(S, freq); };
    slotMode(S, mode0) = S(nentry("[0]Mode [style:menu{'Dual':0;'Wavetable':1;'Ray':2}]", mode0, 0, 2, 1));
    slotHz(S, freq) = freq * ds.exp2(S(nentry("[1]Octave", 0, -2, 2, 1)));

    // Ray (Raycaster's oscillator): its controls, read by the plugin, which
    // plays it (the ranges are Raycaster's). Summed here only so the compiler
    // keeps them; nothing uses the sum.
    rayControls(R, element0) =
        R(nentry("[1]Element [style:menu{'Earth':0;'Water':1;'Air':2;'Fire':3;'Wood':4;'Metal':5;'Chaos':6}]", element0, 0, 6, 1))
      + R(nentry("[2]Chaos Seed", 4821 + 2000 * element0 / 3, 1, 99999, 1))
      + R(checkbox("[3]Free"))
      + R(hslider("[4]Squish", 0, -1, 1, 0.001))
      + R(hslider("[5]Skew", 0, -1, 1, 0.001))
      + R(hslider("[6]Tilt", 0, -1, 1, 0.001))
      + R(hslider("[7]Center", 0, -1.3, 1.3, 0.001))
      + R(hslider("[8]Ray", 0, 0, 1.5, 0.001))
      + R(hslider("[9]Orbit", 0, 0, 0.8, 0.001))
      + R(hslider("[10]Orbit Rate [unit:Hz] [scale:log]", 0.3, 0.02, 1000, 0.01))
      + R(hslider("[11]Fine [unit:cents]", 0, -100, 100, 0.1));

    // The Dual: two basic waves, each picked on its own, and an algorithm.
    // Its arguments go in as inputs, not as expressions: the Dual uses each
    // many times, and the compiler copies an expression into every use
    // (minutes of compiling), where an input is a single wire.
    dual(D, freq, rst, off) = (algo, w1, w2, a, b, freq * ds.exp2(semi / 12), rst, off) : eng.dual
    with {
        algo = D(nentry("[1]Algorithm [style:menu{'VA Sweep':0;'Spread':1;'PWM':2;'Sync':3;'Fractal':4;'Window Amp Sync':5;'Metal':6;'Ring Mod':7;'FM':8;'Noise AM':9;'Chaos':10;'Folding':11}]", 0, 0, 11, 1));
        w1   = D(nentry("[2]Wave 1 [style:menu{'Sine':0;'Triangle':1;'Saw':2;'Square':3}]", 2, 0, 3, 1));
        w2   = D(nentry("[3]Wave 2 [style:menu{'Sine':0;'Triangle':1;'Saw':2;'Square':3}]", 2, 0, 3, 1));
        // VA Sweep at 0.5 is a plain saw: the default patch's sound.
        a    = D(hslider("[4]A", 0.5, 0, 1, 0.001)) : ramped;
        b    = D(hslider("[5]B", 0, 0, 1, 0.001)) : ramped;
        semi = D(nentry("[6]Semi", 0, -12, 12, 1));
    };

    // The Wavetable: four waves from the whole library, one Position that
    // morphs through them in turn (1 -> 2 -> 3 -> 4; its modulators move it),
    // and an OscMod that reshapes the result (see engines.lib). Every unison
    // copy restarts on the same note-on, so they share one position.
    wavetable(W, freq, rst, off) = (wl.wave1(W), wl.wave2(W), wl.wave3(W), wl.wave4(W), position, modType, modDepth,
                                    freq, rst, off) : eng.wavetable
    with {
        position = W(hslider("[5]Position", 0, 0, 1, 0.001)) : ramped;
        modType  = W(nentry("[6]OscMod [style:menu{'Off':0;'Bits 4':1;'SR 11k':2;'SR 8k':3;'SR 4k':4;'Simplify 6k':5;'Simplify 1.5k':6;'Simplify 800':7;'Rectify':8;'Tri Fold':9;'Sine Fold':10;'Squish':11;'Ring':12;'Mirror':13;'Sign Swap':14}]", 0, 0, 14, 1));
        modDepth = W(hslider("[7]OscMod Depth", 0.5, 0, 1, 0.001)) : ramped;
    };

    // ---- Osc 4: noise ------------------------------------------------------
    // Tilted (first-order shelves around 2 kHz) before it joins the filter.
    // Move wanders its level by up to +-18 dB, differently in each voice.
    noise(freq) = ds.noiseSource(kind, freq * 2 ^ ratio, bits, density) : ds.tiltEQ(tilt, 2000)
                  : *(te.exp2(3 * move * te.wander(3000 + 613 * voiceSlot, rate)))
    with {
        kind    = noiseP(nentry("[1]Type [style:menu{'White':0;'Clocked':1;'LFSR Long':2;'LFSR Short':3;'Crackle':4}]", 1, 0, 4, 1));
        ratio   = noiseP(hslider("[2]Clock Ratio [unit:oct]", 0, -4, 4, 1));   // octaves relative to the note
        bits    = noiseP(hslider("[3]Bits", 8, 1, 16, 1));
        density = noiseP(hslider("[4]Crackle Density", 0.3, 0, 1, 0.01)) : ramped;
        tilt    = noiseP(hslider("[5]Tilt [unit:dB]", 0, -24, 24, 0.1)) : ramped;
        move    = noiseP(hslider("[6]Move", 0, 0, 1, 0.01)) : ramped;
        rate    = noiseP(hslider("[7]Rate [unit:Hz] [scale:log]", 1.5, 0.1, 8, 0.01)) : ramped;
    };

    // ---- Transient ---------------------------------------------------------
    // Outside the mixer's balance: a burst inside a normalized mix would duck
    // the sustained sources every time it fired.
    // Not computed while Level is at 0.
    transient(freq, gate) = enabled(eng.transient(kind, decay, pitch, freq, gate > gate'), fader != 0) * lvl
    with {
        kind  = tl.typeMenu(transP);
        decay = transP(hslider("[2]Decay [unit:ms]", 60, 5, 200, 1)) : ramped : /(1000);
        // Exactly 0 is off (the plugin holds a modulated level at 0 only
        // when its knob is there).
        fader = transP(hslider("[3]Level", 0, 0, 1, 0.01));
        lvl   = fader <: !=(0), ramped : *;
        pitch = transP(hslider("[5]Pitch [unit:st]", 0, -24, 24, 0.1)) : ramped;
    };
    // Pre-filter: through drive, filter and amp envelope. Post-filter: added
    // after the amp envelope, so a slow attack can't swallow it.
    transientPost = transP(checkbox("[4]Post-Filter"));

    // ---- Mix ---------------------------------------------------------------
    // Normalized, equal-power balance of the three sources (decided). A fader
    // at exactly 0 mutes its source (the plugin holds a modulated fader at 0
    // only when the fader itself is there).
    level(slider) = mixP(slider) <: !=(0), ramped : *;
    weights = ds.mixWeights(1, level(osc1Fader), level(osc2Fader), level(noiseFader), 0);
    // The faders themselves (inside mixP). A source whose fader is at 0
    // isn't computed at all (enable), in the voice or in its unison copies.
    osc1Fader  = vslider("[1]Osc 1", 1, 0, 1, 0.01);
    osc2Fader  = vslider("[2]Osc 2", 0, 0, 1, 0.01);
    noiseFader = vslider("[3]Noise", 0.15, 0, 1, 0.01);
    sounds(fader) = mixP(fader) != 0;
    w(k) = weights : ba.selector(k, 4);
    // What the balance divides every fader by (mixWeights' n); 0 with all
    // faders down, so nothing the mixer's curves leave over gets through.
    balance = n <: (_ > 0), 1 / max(ma.EPSILON, _) : *
    with { n = sqrt(level(osc1Fader) ^ 2 + level(osc2Fader) ^ 2 + level(noiseFader) ^ 2); };

    // ---- Unison ------------------------------------------------------------
    // Off, U5 or U7: five or seven copies of both oscillators (the noise
    // stays single). Center-weighted spread and a bell of levels:
    // U7 has the center at 0 dB, then pairs at -3, -6 and -12 dB going
    // outward; U5 drops U7's second pair (copies 1 and 5, which the plugin
    // then doesn't run) and moves its inner pair out to 0.4 at -3 dB, its
    // outer pair to -9 dB. Detune is the outer pair's offset in cents (the
    // same in both), skewed so most of the knob covers 0-12 cents.
    // Random Phase restarts each copy at its own random phase on every note;
    // off, all copies restart at phase 0.
    // (Copy k is a control of the copy's own DSP, so these are tables.)
    unisonSpread7 = waveform{-1, -0.55, -0.22, 0, 0.22, 0.55, 1};
    unisonGainDb7 = waveform{-12, -6, -3, 0, -3, -6, -12};
    unisonSpread5 = waveform{-1, 0, -0.4, 0, 0.4, 0, 1};        // copies 1 and 5 unused
    unisonGainDb5 = waveform{-9, -90, -3, 0, -3, -90, -9};
    gains7 = (-12, -6, -3, 0, -3, -6, -12);
    gains5 = (-9, -3, 0, -3, -9);
    norm(n, gains) = 1 / sqrt(sum(k, n, ba.db2linear(ba.take(k + 1, gains)) ^ 2));
    // U7's value, or U5's: a blend by five (0 or 1) rather than select2,
    // which Faust's Rust output got wrong here.
    five = unisonMode == 1;
    u5or7(a7, a5) = a7 + five * (a5 - a7);
    unisonSpreadAt(k) = u5or7((unisonSpread7, int(k) : rdtable), (unisonSpread5, int(k) : rdtable));
    unisonGain(k) = u5or7((unisonGainDb7, int(k) : rdtable), (unisonGainDb5, int(k) : rdtable)) : ba.db2linear;
    unisonNorm    = u5or7(norm(7, gains7), norm(5, gains5));

    unisonMode   = uniP(nentry("[1]Mode [style:menu{'Off':0;'U5':1;'U7':2}]", 0, 0, 2, 1));
    unisonOn     = unisonMode > 0;
    unisonDetune = uniP(hslider("[2]Detune [unit:cents] [skew:0.4]", 6, 0, 50, 0.01)) : ramped;
    randomPhase  = uniP(checkbox("[3]Random Phase"));

    // Unison copy k's start phase. `seed` is a fresh random 0..1 per note from
    // the plugin engine; it's mixed with sampled noise because every voice's
    // noise generator starts from the same state.
    unisonOffset(k, trig, seed) = randomPhase * rand
    with {
        noiseK = no.noise : ba.sAndH(trig);
        rand   = ma.frac(0.5 + 0.5 * noiseK + seed * (k + 1) * 7.31 + k * 0.618);
    };
    unisonFreq(k, freq) = freq * ds.exp2(unisonSpreadAt(k) * unisonDetune / 1200);

    // Copy k: Osc 1 and Osc 2 at its unison level, then as they are.
    // With Unison off the plugin runs only the centre copy, at full level;
    // with U5 only copies 0, 2, 3, 4 and 6.
    // Then, for the plugin's Ray: each slot's pitch, the copy's unison level
    // and start phase, and note-on.
    copy(k) = o1 * level, o2 * level, o1, o2,
              (slotHz(osc1P, f) : attach(_, rayControls(ray1P, 0) + rayControls(ray2P, 3))), slotHz(osc2P, f),
              level, off, trig
    with {
        trig  = noteOn;
        off   = unisonOffset(k, trig, seed);
        f     = unisonFreq(k, freq);
        o1    = slot(osc1P, dual1P, wt1P, 0, f, trig, off) : ds.only(sounds(osc1Fader));
        o2    = slot(osc2P, dual2P, wt2P, 1, f, trig, off) : ds.only(sounds(osc2Fader));
        level = select2(unisonOn, 1, unisonGain(k) * unisonNorm);
    };

    // Two outputs: the tonal mix and the noise, which is routed separately.
    // Noise's Mute comes after the mixer's balance, so the others hold their level.
    noiseOpen = noiseP(checkbox("[8]Mute")) : \(m).(1 - m) : smooth : te.offBelow;
    // The oscillators meet the mixer's saturation at their faders' levels,
    // before the balance scales them down (so Osc 2 up drives it harder,
    // as on a mixer without gain compensation; quiet signals come out as
    // before).
    sources(freq, trig) =
        (osc1In * level(osc1Fader) + osc2In * level(osc2Fader)
         : ds.heated(ds.mixerHeat, heat) : *(balance)),
        enabled(noise(freq), sounds(noiseFader) * (noiseOpen != 0)) * w(2) * noiseOpen;

    // ---- Drive -------------------------------------------------------------
    // Multidrive (decided): soft -> hard -> tube -> fold across the knob,
    // gain rising gently through the lower half and steeply at the top (to
    // 24 dB), plus up to 2.5 dB of extra makeup at the top so heavy drive
    // lands a little louder, not quieter.
    driveStage = ds.multiDrive(amount, 24, bias) : *(ba.db2linear(2.5 * amount))
    with {
        amount = driveP(hslider("[2]Amount", 0.1, 0, 1, 0.001)) : ramped;
        // Character (decided): audio-rate random bias, 500 Hz, depth 0.2,
        // scaled by the Drive Grit setting (skipped at 0).
        bias   = enabled(driveGrit * 0.2 * 1.5 * ds.jitter(500), driveGrit > 0);
    };

    // Noise goes around the drive (decided): a loud tone squashes anything
    // riding on it inside the shaper. `extra` joins the tonal path.
    drivenMix(extra, tonal, noise) = ((tonal + extra) : driveStage) + noise;

    // ---- Filter ------------------------------------------------------------
    // Its envelope and key tracking are the Cutoff knob's modulator's (the
    // plugin's), like any knob's.
    cutoff   = filtP(hslider("[1]Cutoff [unit:Hz] [scale:log]", 1200, 20, 18000, 1)) : ramped;
    reso     = filtP(hslider("[2]Resonance", 0.8, 0.5, 6, 0.01)) : ramped
               : *(1 + 0.5 * bendTo(3)) : ds.clamp(0.5, 8);
    // Character: in-loop saturation, always fully on (decided).
    character = 1;
    morph    = filtP(hslider("[3]Morph LP-Notch-HP", 0, 0, 1, 0.01)) : ramped;
    bandpass = filtP(hslider("[4]Bandpass", 0, 0, 1, 0.01)) : ramped
               : +(0.5 * bendTo(4)) : ds.clamp(0, 1);
    fourPole = filtP(checkbox("[5]4-Pole"));
    // SVF (morphing, 2- or 4-pole), or one of Raycaster's 4-pole lowpasses:
    // a transistor ladder or the SH-101's. Only the chosen one is computed;
    // Morph, Bandpass and 4-Pole are the SVF's. Resonance maps its 0.5..6
    // onto their 0..1 (6, or a bend past it, self-oscillates).
    filterType = filtP(nentry("[0]Type [style:menu{'SVF':0;'Ladder':1;'SH-101':2}]", 0, 0, 2, 1));
    zdfRes     = (reso - 0.5) / 5.5;
    hpfFreq  = filtP(hslider("[8]Utility HPF [unit:Hz] [scale:log]", 20, 10, 2000, 1)) : ramped;

    // ---- Amp ---------------------------------------------------------------
    // The amp envelope (the filter's is now the Cutoff knob's modulator).
    // Not modulatable.
    envKnob(slider) = envP(slider);
    attack  = envKnob(vslider("[1]Attack [unit:s] [scale:log]",  0.005, 0.005, 10, 0.001)) : vary(6, 0.25) : max(0.005);
    decay   = envKnob(vslider("[2]Decay [unit:s] [scale:log]",   0.4,   0.001, 10, 0.001)) : vary(7, 0.25);
    sustain = envKnob(vslider("[3]Sustain",                      0.6,   0, 1, 0.01));
    release = envKnob(vslider("[4]Release [unit:s] [scale:log]", 0.5,   0.001, 10, 0.001)) : vary(8, 0.25);
    // Each segment's bow, as it looks on a graph (+ up, - down; Raycaster's
    // curve buttons). Decay and release default to -0.6, the old single
    // Curve at 0.5; the attack to +0.6, sharper.
    attackBow  = envKnob(vslider("[5]Attack Curve", 0.6, -1, 1, 0.01));
    decayBow   = envKnob(vslider("[6]Decay Curve", -0.6, -1, 1, 0.01));
    releaseBow = envKnob(vslider("[7]Release Curve", -0.6, -1, 1, 0.01));

    ampEnv(gate) = ds.bowedAdsr(attack, decay, sustain, release, attackBow, decayBow, releaseBow, gate);

    filterStage(freq, gate) = _ <: ds.morphFilter(fourPole, filterHz, reso, character, morph, bandpass),
                                   ds.ladderLP(filterHz, zdfRes), ds.sh101LP(filterHz, zdfRes)
                              : ds.choose(3, filterType);

    // The cutoff the filter plays, with everything moving it (also shown on the panel).
    filterHz = cutoff * vintageCutoff * (1 + 0.5 * bendTo(2)) : ds.clamp(20, 18000);

    // ---- Texture ------------------------------------------------------------
    // Spectral events and calls (texture.lib). Both start off: Depth or Level
    // at the bottom of its range is off whatever its modulator, and the plugin then
    // skips this part, so patches from before it sound exactly as they did.
    // The calls' echo is on the shared bus (plugin-callbus.dsp), and so is their
    // Mute. Events' Mute crossfades to the dry voice, and the plugin stops
    // computing them once that's done (voice.rs); their knobs stay as they are.
    eventsOpen = eventsP(checkbox("[0]Mute")) : \(m).(1 - m) : smooth;
    eventsSlots = 6;
    eventsDensity = eventsP(hslider("[1]Density [unit:%]", 80, 0, 100, 1)) : ramped : /(100);
    eventsDepthKnob = eventsP(hslider("[2]Depth [unit:dB]", 0, 0, 12, 0.1));
    eventsDepth   = eventsDepthKnob <: !=(0), ramped : *;
    eventsLife    = eventsP(hslider("[3]Life", 2, 1, 3, 0.01)) : ramped;
    eventsSharp   = eventsP(hslider("[4]Sharp", 1, 0.5, 4, 0.01)) : ramped;

    callsOff   = -80;
    callsLevelKnob = callsP(hslider("[1]Level [unit:dB]", callsOff, callsOff, -26, 0.1));
    callsLevel = callsLevelKnob <: (_ > callsOff), (ramped : /(6.0206) : te.exp2) : *;
    callsActivity = callsP(hslider("[2]Activity", 0.45, 0, 1, 0.01)) : ramped;
    callsRate     = callsP(hslider("[3]Rate", 1, 0.25, 3, 0.01)) : ramped;
    // A voice here is about twice as loud as on the bench where Level was set by
    // ear, so that the same reading gives the same balance against the voice.
    callsMakeup = 2;

    // Events are computed only while on (Depth above 0, not muted or still
    // fading), calls only while their Level is above off.
    textureOut(in, hz, amp) =
        select2(eventsOn, in, in + eventsOpen * (enabled(in : te.events(eventsSlots, 1000 + 337 * voiceSlot, hz,
                                       eventsDensity, eventsDepth, eventsLife, eventsSharp), eventsOn) - in)),
        (te.calls(2000 + 811 * voiceSlot, hz, callsActivity, callsRate) : par(i, 2, ds.only(callsOn))
         : *(level), *(level))
    with {
        level    = callsLevel * callsMakeup * amp;
        eventsOn = (eventsDepthKnob != 0) & (eventsOpen > 1e-4);
        callsOn  = callsLevelKnob > callsOff;
    };

    // ---- Output ------------------------------------------------------------
    out =
        (sources(freq, gate > gate') : drivenMix(tr * (1 - transientPost))
         : filterStage(freq, gate)
         : ds.heated(ds.postClip, heat)
         : ds.utilityHPF(hpfFreq)
         : *(ampEnv(gate)) : +(tr * transientPost)
         : *(gain * 0.5 * vintageGain)),
        filterHz, reso, morph, bandpass, hpfFreq,
        freq, ampEnv(gate)
    with { tr = transient(freq, gate); };

    // The note's pitch. Portamento glides it exponentially (evenly in
    // octaves), reaching the new note in about the glide time.
    glided = log(freq0) : si.smooth(ba.tau2pole(max(0.00001, glide) / 3)) : exp;
    freq   = glided * ds.exp2(pitchSemis / 12);
};
