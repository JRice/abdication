//==========================================================================
// mod.lib — the voice's two free modulators, Mod Env and Mod LFO, as their
// own small Faust DSP (plugin-mod.dsp). The plugin runs one per voice and
// feeds both signals into the voice (voice.lib), where almost every knob
// and mix fader takes a send ("ring") from each.
//
// They're a separate DSP for the compiler's sake: with the modulators
// inside the voice, every send carried their whole definition, and the
// Faust compiler's evaluation ran for tens of minutes and out of memory.
// As inputs, they're plain signals to the voice.
//==========================================================================

import("stdfaust.lib");
ds = library("core.lib");
eng = library("engines.lib");
wl = library("wavelib.lib");

menvP(x) = hgroup("[2.1]Mod Env", x);
mlfoP(x) = hgroup("[2.2]Mod LFO", x);

// As voice.lib: the gate (driven by the plugin with the voice's), note-on,
// and control smoothing that snaps on note-on.
noteOn = button("gate") <: _ > _';
smooth = si.smooth((1 - 44.1 / ma.SR) * (1 - noteOn));

// The free envelope: an ADSR with curve, restarted by every note.
env = ds.adsr(a, d, s, r, c, button("gate"))
with {
    a = menvP(vslider("[1]Attack [unit:s] [scale:log]",  0.005, 0.001, 10, 0.001));
    d = menvP(vslider("[2]Decay [unit:s] [scale:log]",   0.5,   0.001, 10, 0.001));
    s = menvP(vslider("[3]Sustain",                      0,     0, 1, 0.01));
    r = menvP(vslider("[4]Release [unit:s] [scale:log]", 0.5,   0.001, 10, 0.001));
    c = menvP(vslider("[5]Curve",                        0.5,  -1, 1, 0.01));
};

// The free LFO: any library wave. Free: Rate in Hz (0.02-20), restarted
// by every note. Sync: Rate steps through note values (4 bars .. 1/32,
// dotted and triplet), locked to the host's bar position, so every voice
// is in step. The engine passes the tempo and the song position (in
// beats, modulo 48, a multiple of every note value) at the start of each
// block; the LFO counts on from there at the tempo. Rate takes a send
// from the envelope (in its travel, like every send).
tempo = hslider("tempo", 120, 1, 999, 0.001);
beats = hslider("beats", 0, 0, 48, 0.000001);
rateLo = 0.02;
rateHi = 20;
noteValues = waveform{16, 8, 4, 3, 2, 1.5, 1.3333333, 1, 0.75, 0.6666667, 0.5, 0.3333333, 0.25, 0.1666667, 0.125};

lfo = eng.wtRead(wl.lfoWave(mlfoP), 0, select2(sync, free, synced))
with {
    sync    = mlfoP(checkbox("[3]Sync"));
    rate    = mlfoP(hslider("[1]Rate [unit:Hz] [scale:log]", 1, 0.02, 20, 0.001)) : smooth;
    send    = mlfoP(hslider("[1]Rate Env", 0, -1, 1, 0.001));
    travel  = ds.clamp(0, 1, sqrt(sqrt(max(0, (rate - rateLo) / (rateHi - rateLo)))) + send * env);
    hz      = rateLo + (rateHi - rateLo) * travel ^ 4;
    free    = ds.phasor(hz, noteOn, 0);
    moved   = beats != beats';
    since   = (+(1) : *(1 - moved)) ~ _;
    beatNow = beats + since * tempo / (60 * ma.SR);
    noteLen = noteValues, int(travel * 14 + 0.5) : rdtable;
    synced  = ma.frac(beatNow / noteLen);
};
