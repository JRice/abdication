//==========================================================================
// drum.lib — ABDrum's sound layers as pure DSP: no UI, no MIDI.
// voice.lib attaches the controls.
//
// Sections:
//   1. Hit timing and envelopes (shared by every layer)
//   2. Tone   — swept oscillator with one Shape knob
//   3. Body   — modal resonator struck by a mallet
//   4. Noise  — generated source + loop, crush, density, clap, BP -> HP
//   5. Hits   — the sample layers' player
//
// Conventions (from Abdication's core.lib): times in seconds, branch-free
// selects as 0/1 factors where nesting would trip the Faust 2.70 Rust
// backend, and every layer silent until its first trigger.
//==========================================================================

declare name "abdrum-layers";
declare version "0.1";

import("stdfaust.lib");
ds = library("core.lib");
sl = library("samplelib.lib");

//--------------------------------------------------------------------------
// 1. Hit timing and envelopes
//--------------------------------------------------------------------------

LN1000 = 6.907755;                                     // decay to -60 dB

// Seconds since the last trigger (0 on the trigger sample itself).
since(trig) = ((+(1) : *(1 - trig)) ~ _) / ma.SR;

// 1 from the first trigger on: keeps layers silent at plugin start.
armed(trig) = trig : (max ~ _);

// Falls from 1 to 0.001 (-60 dB) over `t60` seconds.
decay60(t60, t) = exp(-LN1000 * t / max(1e-4, t60));

// The two-speed drum envelope shared by Tone and Noise: a linear attack,
// then a fast decay that hands over to a slow one. `tail` is the slow
// decay's share at the start (0 = all fast, 1 = all slow).
twoStage(attack, fast, slow, tail, t) = ramp * ((1 - k) * decay60(fast, t) + k * decay60(slow, t))
with {
    ramp = min(1, t / max(1e-5, attack));
    k = ds.clamp(0, 1, tail);
};

// A pitch drop in semitones: `depth` falling to 5 % of itself over `time`.
drop(depth, time, t) = depth * exp(-3 * t / max(1e-4, time));

// Velocity as a scaler: amount 0 ignores velocity, 1 follows it fully.
velScale(amount, vel) = 1 - amount * (1 - vel);

// Velocity as a time scaler: full velocity keeps the time; at amount 1 a
// silent hit takes a quarter of it (0 ignores velocity, exactly).
velTime(amount, vel) = ds.exp2(-2 * amount * (1 - vel));

// A stable random value in -1..1 for this hit (the engine sets `seed` per
// note) and trait k, so each varying parameter gets its own offset.
trait(seed, k) = 2 * ma.frac(sin(seed * 12.9898 + k * 78.233) * 43758.5453) - 1;

//--------------------------------------------------------------------------
// 2. Tone
//    A sine whose phase restarts at 0 on every hit (no click of its own),
//    swept by two pitch drops. Shape, in thirds of its travel:
//    sine -> triangle, then soft saturation, then folding.
//    TODO: oversample the saturation/fold once the sound is settled.
//--------------------------------------------------------------------------

shaper(shape, p) = (1 - fm) * sat + fm * fold
with {
    s    = ds.clamp(0, 1, shape) * 3;
    sine = sin(2 * ma.PI * p);
    tri  = 1 - 4 * abs(ma.frac(p + 0.25) - 0.5);       // starts at 0, rising
    m1   = ds.clamp(0, 1, s);
    base = (1 - m1) * sine + m1 * tri;
    g2   = 1 + 5 * ds.clamp(0, 1, s - 1);
    sat  = ma.tanh(base * g2) / ma.tanh(g2);
    m3   = ds.clamp(0, 1, s - 2);
    fm   = min(1, 4 * m3);
    fold = sin(ma.PI / 2 * sat * (1 + 3 * m3));
};

// hz: resting pitch; semis: the summed pitch drops at this instant (two of
// them, `alt` choosing the second: Tone's plain drops or its swoop).
// The pitch may start above Nyquist, up to TONE_TOP of the sample rate (35
// kHz at 44.1), and fold back down: a deep Drop from there is a laser, the
// fold a downward chirp heard rising (after Nepheton's laser gun, Nov 2026).
// It used to stop at 0.45: below that nothing changes.
TONE_TOP = 0.8;
tone(hz, semis, semisAlt, alt, shape, trig) = shaper(shape, ds.phasor(toneFreq(hz, semis, semisAlt, alt), trig, 0));
toneFreq(hz, semis, semisAlt, alt) = min(TONE_TOP * ma.SR, select2(alt, hz * ds.exp2(semis / 12), hz * ds.exp2(semisAlt / 12)));

// ---- Osc 2 (after the two-operator engines of Unfiltered Audio's
// Battalion, Nov 2026): a second oscillator at `ratio` times Tone's
// frequency (so it follows the drop too), restarted by every hit, used one
// of four ways (mode):
//   0 FM: it phase-modulates Tone (index up to OSC2_INDEX cycles, by
//     amount squared); Feedback adds Tone's own last sample to its phase
//     (self-FM, noise at the top: a hat).
//   1 Tangle: Tone and a sine at the ratio combined; Morph walks through
//     TANGLE_ALGOS ways (crossfading neighbours); amount is the wet share.
//   2 Shame: each one's zero crossings sample-and-hold the other; Morph
//     walks through the held mixes; amount is the wet share.
//   3 VOSIM: a sine at the ratio, hard-synced to Tone's cycle and faded
//     by a falling window each cycle (Window: from a straight fall to a
//     steep one): a formant; amount is the wet share.
//   4 Surf (after the Wave drum of Jeremy's Fulmen, Nov 2026): SURF_HARMONICS
//     band-limited harmonics of Tone with a Gaussian peak at harmonic `ratio`
//     (Window: its width, ~0.7 to ~4.7 harmonics); ringing Ratio sweeps the
//     peak (a clean wah). Amount is the wet share.
// Only the chosen mode is computed (enable). The caller keeps the plain
// Tone when Osc 2, Rattle and Damp are all off.
OSC2_INDEX = 1.5;
OSC2_FEEDBACK = 1.6;
toneOsc2(mode, f, ratio, amount, feedback, morph, window, shape, trig) =
    enable(fm, mode == 0), enable(tangle, mode == 1), enable(shame, mode == 2), enable(vosim, mode == 3), enable(surf, mode == 4) :> _
with {
    a  = ds.clamp(0, 1, amount);
    p1 = ds.phasor(f, trig, 0);
    f2 = min(TONE_TOP * ma.SR, f * ratio);
    s2 = sin(2 * ma.PI * ds.phasor(f2, trig, 0));
    y1 = shaper(shape, p1);
    wet(x) = y1 + a * (x - y1);
    fm = (+(p1 + OSC2_INDEX * a * a * s2) : ma.frac : shaper(shape)) ~ *(OSC2_FEEDBACK * ds.clamp(0, 1, feedback));
    tangle = wet(morphMix(TANGLE_ALGOS, tangles, morph));
    tangles = (y1 + s2) * 0.7071, y1 * s2 * 1.4142, y1 * (s2 > 0), y1 + (abs(s2) > abs(y1)) * (s2 - y1),
              abs(y1) * (2 * (s2 > 0) - 1), 1.7 * sin(ma.PI * (y1 + s2) / 2) * sin(ma.PI * y1 * s2);
    shame = wet(morphMix(4, shames, morph));
    h1 = ba.sAndH(s2 * s2' < 0, y1);
    h2 = ba.sAndH(y1 * y1' < 0, s2);
    shames = h1, h2, (h1 + h2) * 0.7071, h1 * h2 * 1.4142;
    vosim = wet(VOSIM_LEVEL * pow(1 - p1, 1 + 7 * ds.clamp(0, 1, window)) * sin(2 * ma.PI * ma.frac(max(1, ratio) * p1)));
    // Harmonic h by the Chebyshev recurrences x(h a) = 2 cos(a) x((h-1) a) - x((h-2) a),
    // at Schroeder's phases (pi h^2 / N), so a wide peak doesn't stack into a spike.
    // (Half a cycle on from p1: only flips odd harmonics' signs, and spelled
    // this way the FM sum above keeps the order it always rounded in.)
    theta = 2 * ma.PI * ma.frac(p1 + 0.5);
    sinH = case { (0) => 0; (1) => sin(theta); (h) => 2 * cos(theta) * sinH(h - 1) - sinH(h - 2); };
    cosH = case { (0) => 1; (1) => cos(theta); (h) => 2 * cos(theta) * cosH(h - 1) - cosH(h - 2); };
    harmonic(h) = sinH(h) * cos(ma.PI * h * h / SURF_HARMONICS) + cosH(h) * sin(ma.PI * h * h / SURF_HARMONICS);
    peak  = ds.clamp(1, SURF_HARMONICS, ratio);
    width = 0.7 + 4 * ds.clamp(0, 1, window);
    weight(h) = exp(0 - ((h - peak) / width) ^ 2) * (h * f < 0.45 * ma.SR);
    surfNorm = sqrt(max(1e-6, sum(i, SURF_HARMONICS, weight(i + 1) ^ 2)));
    surf  = wet(SURF_LEVEL * sum(i, SURF_HARMONICS, weight(i + 1) * harmonic(i + 1)) / surfNorm);
};
SURF_HARMONICS = 16;
SURF_LEVEL = 1.12;                                      // level-matched to the plain Tone (measured)
// Rattle (after Battalion's Pillow kick and its Roast): Tone ring-modulated
// by pink noise, mixed in by `amount`: a noisy halo that rides Tone's pitch
// (and its drop). RATTLE_GAIN matches its level to the clean Tone's.
RATTLE_GAIN = 21.6;
rattle(amount, y) = y * (1 + ds.clamp(0, 1, amount) * (RATTLE_GAIN * no.pink_noise - 1));

// Damp (after the lowpass gate in Battalion's Terraining): a lowpass that
// opens with Tone's amplitude envelope (velocity in it) and closes as the
// hit fades, so hits darken as they die: at the peak 20 kHz; below it
// env^(4 * damp) of that (at full Damp, half the level is 1.25 kHz).
// Simper's SVF (robust when its cutoff moves every sample).
LPG_FLOOR = 40;
lpg(damp, env, y) = y : fi.svf.lp(fc, 0.7071)
with { fc = ds.clamp(LPG_FLOOR, 0.45 * ma.SR, 20000 * pow(max(1e-6, env), 4 * ds.clamp(0, 1, damp))); };

TANGLE_ALGOS = 6;
VOSIM_LEVEL = 2.4;
// Morph 0..1 across n signals in order, crossfading neighbours.
morphMix(n, sigs, morph) = sigs : par(k, n, *(weight(k))) :> _
with {
    pos = ds.clamp(0, 1, morph) * (n - 1);
    weight(k) = max(0, 1 - abs(pos - k));
};


//--------------------------------------------------------------------------
// 3. Body
//    24 two-pole resonators ("modes"), each a decaying sine at the
//    body pitch times a ratio. Material sweeps the ratios through three
//    real objects, all inharmonic (a harmonic tube stop read as a chord,
//    not a drum, so it was dropped); Brightness decides how fast and how loud the upper
//    modes are; the strike position (hidden) weights the modes.
//--------------------------------------------------------------------------

MODES = 24;

// Overtone ratios, k = 0..23, computed from the physics: an ideal circular
// membrane (zeros of the Bessel functions), a simply supported rectangular
// plate with sides in the golden ratio (distinct m^2 + (n/phi)^2: a square
// plate's overtones are rational and drift toward a chord), a free-free
// bar (roots of cos(b) cosh(b) = 1, squared).
membrane(k) = ba.take(k + 1, (1.000, 1.593, 2.136, 2.295, 2.653, 2.917, 3.155, 3.500, 3.598, 3.647, 4.059, 4.132,
                              4.230, 4.601, 4.610, 4.832, 4.903, 5.084, 5.131, 5.412, 5.540, 5.553, 5.651, 5.977));
plate(k)    = ba.take(k + 1, (1.000, 1.829, 3.171, 3.211, 4.000, 5.146, 5.382, 6.789, 7.317, 7.618, 7.633, 9.000,
                              9.804, 10.674, 10.935, 11.854, 12.683, 12.845, 13.422, 14.065, 14.267, 16.000, 16.438, 16.463));
bar(k)      = ba.take(k + 1, (1.000, 2.757, 5.404, 8.933, 13.344, 18.638, 24.814, 31.872, 39.812, 48.635, 58.340, 68.927,
                              80.397, 92.748, 105.982, 120.099, 135.097, 150.978, 167.741, 185.386, 203.914, 223.324, 243.616, 264.790));

// Material 0..1 crosses membrane -> plate -> bar; in between, the
// neighbouring ratios blend in the log domain (so the morph is even in pitch).
weight(material, j) = max(0, 1 - abs(ds.clamp(0, 1, material) * 2 - j));
ratio(material, k) = exp(weight(material, 0) * log(membrane(k)) + weight(material, 1) * log(plate(k))
                       + weight(material, 2) * log(bar(k)));

// How much a hard hit bends each material's pitch: skins stretch; plates
// and bars don't.
bendiness(material) = weight(material, 0);

// Where each material rests when struck (0..1 along it): skins a little
// off centre, bars near the end.
restingPosition(material) = weight(material, 0) * 0.30 + weight(material, 1) * 0.37 + weight(material, 2) * 0.22;

// One mode, a two-pole resonator:
//   y[n] = g x[n] + a1 y[n-1] - a2 y[n-2]
// with a1 = 2 r cos(w), a2 = r^2 and g = sin(w) for an impulse in to ring a
// sine of amplitude 1 at w, falling 60 dB in t60 (r = 10^(-3 / (t60 SR))).
// (A one-input box on purpose: taking x as a "_" argument inside the
// recursion wires the feedback into the wrong input.)
mode(a1, a2, g) = *(g) : + ~ (_ <: *(a1), (mem : *(a2)) : -);

// The same mode overloaded (Body Clip; after the clipped 606 resonators in
// D16's Nithonat, Nov 2026, but gentler and audible: a hard clip inside a
// struck high-Q loop only drains the ring at once, which on its own sounds
// like a level change). Two parts, both relative to the mode's limits
// (-lo below, +hi above, hi > lo, so it's lopsided):
//   - in the loop, each sample pulls CLIP_DRAIN of whatever lies beyond the
//     limits back in, so a loud ring loses its excess over some 20 ms (loud
//     hits ring shorter, then decay as before);
//   - on the way out, a soft clip x / (1 + x / limit), harder below than
//     above: squarer and lopsided while the ring is loud, clean once it has
//     fallen under the limits. invLo/invHi are 1/lo, 1/hi (0 = off: exact).
CLIP_DRAIN = 0.002;
CLIP_HI = 2.5;                                          // the upper limit, as a multiple of the lower
modeClipped(a1, a2, g, lo, invLo, invHi) = *(g) : (+ : drain) ~ (_ <: *(a1), (mem : *(a2)) : -) : shape
with {
    drain(y) = y - CLIP_DRAIN * (max(0, y - CLIP_HI * lo) + min(0, y + lo));
    shape(y) = y / (1 + max(0, 0 - y) * invLo + max(0, y) * invHi);
};

// The mallet: a half-sine pulse, 5 ms wide when soft down to 0.08 ms when
// hard, scaled so the lowest mode rings equally loud at any hardness
// (softness only removes highs), plus a little noise as it hardens.
mallet(hardness, t) = pulse * (1 + noise)
with {
    h     = ds.clamp(0, 1, hardness);
    width = 0.005 * pow(0.016, h);
    pulse = (t < width) * sin(ma.PI * t / width) * ma.PI / (2 * width * ma.SR);
    noise = 0.6 * h * no.noise;
};

// hz: body pitch (bend already applied); t60: base decay; bright, position 0..1;
// clip 0..1: Body Clip, already scaled by the hit's velocity (0 = off, exact).
// The modes' levels are normalized by their total energy, so every
// material and brightness comes out at about the same loudness (0.3 sets
// that loudness near Tone's: the modes all start together, so the very
// first instant peaks well above the ring).
//
// CPU: the 24 modes' coefficients take ~7 transcendental functions each.
// Their inputs move only as fast as knobs, bends and rings, so the plugin
// runs the Body as its own DSP (plugin-body.dsp) with those inputs as
// controls, set once per 64-sample block: Faust then computes the
// coefficients once per block, not per sample, and they glide to their new
// values over ~1.5 ms (`snap` 1 jumps them, on a hit). About a tenth of the
// per-sample cost, and nothing at all while the Body is off.
COEF_GLIDE = 0.0003;

body(hz, material, t60, bright, position, clip, snap, exciter) = exciter <: par(k, MODES, voice(k)) :> unlean
with {
    b = ds.clamp(0, 1, bright);
    rk(k)  = ratio(material, k);
    amp(k) = pow(rk(k), -1.5 * (1 - b)) * (0.35 + 0.65 * abs(sin(ma.PI * (k + 1) * position)))
           * (hz * rk(k) < 0.45 * ma.SR);
    norm = max(0.1, sqrt(sum(k, MODES, amp(k) * amp(k))));
    w(k)  = 2 * ma.PI * min(hz * rk(k), 0.45 * ma.SR) / ma.SR;
    r(k)  = exp(-LN1000 / (max(1e-3, t60 * pow(rk(k), -1.2 * (1 - b))) * ma.SR));
    glide = si.smooth(exp(-1 / (COEF_GLIDE * ma.SR)) * (1 - snap));
    // Clip's drive runs 1..CLIP_DRIVE (exponentially along the knob, with
    // velocity in it). Each mode's lower limit is its nominal ring (what a
    // full mallet hit rings its lowest mode at: amp(k) * 0.3 / norm) over the
    // drive's excess (drive - 1), so it starts far off and closes in smoothly;
    // makeup drive^CLIP_MAKEUP holds the start near the clean ring's (the
    // tail a little louder: denser). Off: no limits, no makeup, exactly.
    on     = clip > 1e-4;
    excess = pow(CLIP_DRIVE, ds.clamp(0, 1, clip) * on) - 1 : glide;
    nominal(k) = max(1e-9, amp(k) * 0.3 / norm);       // (modes above Nyquist have none)
    lo(k)  = select2(on, 1e30, nominal(k) / max(1e-6, excess));
    voice(k) = modeClipped(2 * r(k) * cos(w(k)) : glide, r(k) * r(k) : glide, sin(w(k)) * amp(k) * 0.3 / norm : glide,
                           lo(k), excess / nominal(k), excess / (CLIP_HI * nominal(k)));
    // The lopsided ring carries DC; while Clip is on, a 10 Hz highpass takes
    // it out (off, the output passes untouched).
    unlean(y) = (y + on * (fi.highpass(1, 10, y) - y)) * pow(1 + excess, CLIP_MAKEUP);
};
CLIP_DRIVE = 16;
CLIP_MAKEUP = 0.6;

// ---- String (Body's second model; after the Karplus voice of Jeremy's
// Fulmen, Nov 2026, built my own way): a Karplus-Strong loop at the Body's
// pitch. The Body's exciter plucks it, plus a burst of noise one period long
// (the brighter the strike, the more of it), taken at the strike position (a
// comb on the pluck: plucked halfway, the even harmonics are missing; near
// the end, thin). In the loop: a one-pole lowpass, two first-order allpasses
// (Material: 0 a harmonic string, up a stiff, stretched one) and the loop
// gain. The lowpass is set so harmonic 8 rings STRING_DARK..STRING_OPEN times as long
// as the fundamental (Strike, as the modes' brightness), whatever the pitch,
// and the gain rings the fundamental for the decay. The delay is shortened
// by what the lowpass and allpasses add at the fundamental, so it stays in
// tune. Clip saturates the loop (tanh) and leans the ring, with makeup.
// The Body as a model at a level: 0 the modes, 1 the string. The string is
// computed only when chosen; with the modes it's the modes exactly (the
// level goes on first so the product is the one it always was).
bodyModel(model, level, hz, material, t60, bright, position, clip, snap, exciter) = modes + isString * (strung - modes)
with {
    isString = model > 0.5;
    modes  = body(hz, material, t60, bright, position, clip, snap, exciter) * level;
    strung = enable(string(hz, material, t60, bright, position, clip, snap, exciter) * level, isString);
};

STRING_MAX = 8192;                                      // samples: 20 Hz at 163 kHz
STRING_LEVEL = 0.74;                                    // near the modes' level (measured)
STRING_NOISE = 0.6;
STRING_DARK = 0.03;
STRING_OPEN = 0.6;
STRING_GAIN_MAX = 0.9995;
STRING_MAKEUP = 1.0;
STRING_LEAN = 0.5;
STRING_DRIVE = 8;
STRING_STIFF = 0.9;                                    // Clip's makeup: drive^this
string(hz, material, t60, bright, position, clip, snap, exciter) = pluck : (+ : sat) ~ loopBack : lean : fi.highpass(1, 20) : *(STRING_LEVEL * makeup)
with {
    b  = ds.clamp(0, 1, bright);
    f  = ds.clamp(max(20, ma.SR / (STRING_MAX - 8)), 0.45 * ma.SR, hz);
    w  = 2 * ma.PI * f / ma.SR;
    period = ma.SR / f;
    decay = max(1e-3, t60);
    // The lowpass pole a: |H(w8)|^2 / |H(w)|^2 = R, the extra loss per period
    // at w8 that rings it `ratio` times as long, solved for a (a quadratic
    // whose roots multiply to 1: the one inside the circle), capped where
    // the pole can't go darker.
    w8    = min(8 * w, 0.8 * ma.PI);
    ratio = STRING_DARK + (STRING_OPEN - STRING_DARK) * b * b;
    R     = max(1e-4, exp(0 - 2 * LN1000 / (decay * f) * (1 / ratio - 1)));
    B     = (cos(w) - R * cos(w8)) / min(-1e-6, R - 1);
    aR    = 0 - B - sqrt(max(0, B * B - 1));
    // ... and no darker than leaves the fundamental its decay with the loop
    // gain under 1 (|H(w)| >= g / GAIN_MAX: the same quadratic's form).
    g     = exp(0 - LN1000 / (decay * f));
    gg    = min(0.999999, g / STRING_GAIN_MAX) ^ 2;
    K     = (1 - gg * cos(w)) / (1 - gg);
    aF    = K - sqrt(max(0, K * K - 1));
    a     = ds.clamp(0, 0.995, min(aR, aF));
    // The allpasses' coefficient (stiffness): to -STRING_STIFF, held where
    // their delay (at most (1 - c) / (1 + c) each) would pass a quarter period.
    q  = period / 4;
    m  = ds.clamp(0, 1, material);
    c  = 0 - min(STRING_STIFF * (1 - (1 - m) * (1 - m)), (q - 1) / (q + 1));
    // Phase delays at the fundamental (samples).
    lpDelay = atan2(a * sin(w), 1 - a * cos(w)) / w;
    apDelay = (atan2(sin(w), c + cos(w)) - atan2(c * sin(w), 1 + c * cos(w))) / w;
    delay = max(2, period - 1 - lpDelay - 2 * apDelay);
    lpGain = (1 - a) / sqrt(1 - 2 * a * cos(w) + a * a);
    gain = min(STRING_GAIN_MAX, g / lpGain);
    lp = *(1 - a) : + ~ *(a);
    ap = fi.tf1(c, 1, c);                              // (c + z^-1) / (1 + c z^-1)
    loopBack = de.fdelaylti(3, STRING_MAX, delay) : lp : ap : ap : *(gain);
    // The pluck: the exciter plus a period of noise, through the strike comb.
    since = ba.countup(STRING_MAX, snap);
    burst = no.noises(4, 1) * (since < period) * STRING_NOISE * (0.25 + 0.75 * b);
    pick  = (0.08 + 0.42 * ds.clamp(0, 1, position)) * period;
    // Softened as a strike softens: a one-pole lowpass at 1.5..25.5
    // harmonics, so a soft pluck puts its energy where the string rings.
    soft  = exp(0 - 2 * ma.PI * min(0.45 * ma.SR, f * (1.5 + 24 * b * b)) / ma.SR);
    // (Made up for the noise power the lowpass takes: (1 - a) / (1 + a).)
    pluck = exciter * 2 + burst : *((1 - soft) * sqrt((1 + soft) / (1 - soft))) : + ~ *(soft) <: _ - de.fdelay(STRING_MAX, pick) * 0.95;
    // Clip: tanh(d y) / d in the loop, d = 1..STRING_DRIVE, then the ring
    // leaned on the way out (a lopsided tanh, driven 3x: even harmonics, like the
    // modes'; the highpass takes its DC). Off, untouched. (In the loop the
    // lean would make DC, and taking that out there makes it self-oscillate.)
    on    = clip > 1e-4;
    drive = exp(log(STRING_DRIVE) * min(1, clip) * on);  // (Clip is never below 0)
    sat(y) = y + on * (ma.tanh(drive * y) / drive - y);
    // (Divided by its slope at rest, so quiet rings pass as they were.)
    lean(y) = y + on * ((ma.tanh(3 * drive * y + STRING_LEAN) - ma.tanh(STRING_LEAN)) / (3 * drive * (1 - ma.tanh(STRING_LEAN) ^ 2)) - y);
    makeup = exp(log(drive) * STRING_MAKEUP);
};

//--------------------------------------------------------------------------
// 4. Noise
//--------------------------------------------------------------------------

// Dust: random clicks of random size, about 3000 a second, dense enough
// that even a 10 ms hit catches some (Density thins them further).
// Soft-limited, so its peaks stay at full scale.
dust = ma.tanh((u < 3000 / ma.SR) * no.noises(3, 2) * 3.7)
with { u = (no.noises(3, 1) + 1) / 2; };

// Metal: six square waves at the 808's cymbal and hat ratios, tuned to hz
// (the 808's own cluster is hz = 205 Hz). Band-limited (PolyBLEP).
metalRatios = (1.000, 1.483, 1.800, 2.546, 2.630, 3.897);
square(hz) = naive - ds.polyblep(p, dt) + ds.polyblep(ma.frac(p + 0.5), dt)
with {
    dt = min(hz, 0.45 * ma.SR) / ma.SR;
    p = os.lf_sawpos(hz);
    naive = select2(p < 0.5, -1, 1);
};
// `spreadOn`: Spread is set (knob or ring); off, the 808 bank runs exactly
// as it always did, and the spread bank isn't computed (nor, on, the plain).
metal(hz, spread, spreadOn) = plainBank + spreadOn * (enable(bank(ratio), spreadOn) - plainBank)
with {
    plainBank = enable(bank(r), 1 - spreadOn);
    bank(rt) = par(k, 6, square(hz * rt(k))) :> /(6) : *(1.4);
    // Spread (after the hi-hat's Harmonic in Unfiltered Audio's Battalion,
    // Nov 2026): 0 = the 808's ratios (exactly); toward -1 they slide (in
    // log) onto the harmonic series 1..6, a buzzy chord; toward +1 they
    // stretch (r^(1 + 0.6 * spread)), wider and clangier.
    r(k) = ba.take(k + 1, metalRatios);
    sp = ds.clamp(-1, 1, spread);
    // (Arithmetic blends, not select2: as factors, Faust 2.70's Rust backend
    // can't take them.)
    neg = sp < 0;
    moved(k) = (1 - neg) * pow(r(k), 1 + 0.6 * sp) + neg * exp((1 + sp) * log(r(k)) - sp * log(k + 1));
    ratio(k) = moved(k);
};

// RF: a digital transmitter's interference, as a speaker cable or an
// overloaded receiver hears it (a GSM phone's 217 Hz buzz, a data burst on
// shortwave). Bursts at `frameHz` (Tone's pitch), on for RF_DUTY of each
// frame, about one frame in five missing at random, so the buzz stutters.
// Each burst is a stream of random FSK symbols, RF_BAUD to a frame, hopping
// among four tones a quarter-octave apart around `dataHz` (the Noise's Freq,
// so the bandpass sits on them); each burst also starts high and falls a
// few semitones into place, as a transmitter keying up pulls its own
// carrier. The detector rectifies (strongly lopsided) and clips: the burst
// envelope becomes the buzz, the hops a tortured warble. Between bursts the
// receiver's hiss.
RF_DUTY = 0.3;
RF_KEEP = 0.8;                                          // the chance a frame carries a burst
RF_BAUD = 12;                                           // symbols per frame
RF_CHIRP = 0.3;                                         // each burst starts this much higher (ratio - 1)
RF_HISS = 0.12;
RF_LEVEL = 1.7;                                         // matches white noise's level (measured)
rf(frameHz, dataHz) = (burst * detected + (1 - burst) * RF_HISS * no.noises(4, 2)) : fi.highpass(1, 20) : *(RF_LEVEL)
with {
    fHz      = ds.clamp(1, 0.1 * ma.SR, frameHz);
    frame    = os.lf_sawpos(fHz);
    keep     = ba.sAndH(frame < frame', no.noises(4, 0)) > 1 - 2 * RF_KEEP;
    burst    = (frame < RF_DUTY) * keep;
    symbol   = os.lf_sawpos(fHz * RF_BAUD);
    level    = floor(ds.clamp(0, 3.999, (ba.sAndH(symbol < symbol', no.noises(4, 1)) + 1) * 2));
    chirp    = 1 + RF_CHIRP * pow(ds.clamp(0, 1, 1 - frame / RF_DUTY), 2);
    carrier  = sin(2 * ma.PI * os.lf_sawpos(ds.clamp(20, 0.45 * ma.SR, dataHz * ds.exp2((level - 1.5) / 4) * chirp)));
    detected = ma.tanh(3 * (carrier + 0.8 * abs(carrier)));
};

// Ramp: after the 606 snare noise in D16's Nithonat (Nov 2026): a ramp that
// charges toward 1 (in RAMP_TAU) and drops to 0 whenever a dark noise
// (lowpassed at RAMP_HZ) is below zero, so it rises, holds and falls at
// random: a sawtooth crackle, rounded going up, sharp coming down.
RAMP_HZ = 2000;
RAMP_TAU = 0.00011;
RAMP_LEVEL = 1.67;                                      // matches white noise's level (measured)
ramp = charge ~ _ : fi.highpass(1, 20) : *(RAMP_LEVEL)
with {
    dark = no.noises(4, 3) : fi.lowpass(1, RAMP_HZ);
    c = 1 - exp(-1 / (RAMP_TAU * ma.SR));
    charge(prev) = (prev + c * (1 - prev)) * (dark >= 0);
};

// Generated sources, level-matched to white noise (about -5 dB RMS; dust,
// being clicks, sits lower):
//   0 white | 1 pink | 2 dust | 3 sample-and-hold at `rate` | 4 metal at `hz`
//   | 5 RF, framed at `hz`, its data at half `rate` (the bandpass) | 6 ramp.
// (Metal, RF and ramp are computed only while chosen: Faust's enable() skips them.)
generated(kind, rate, hz, spread, spreadOn) = ba.selectn(7, kind,
    no.noise,
    no.pink_noise * 11.6,
    dust,
    ds.clockedNoise(rate, 12),
    enable(metal(hz, spread, spreadOn), kind == 4),
    enable(rf(hz, rate / 2), kind == 5),
    enable(ramp, kind == 6));

// A noise loop from the library, from a random point chosen per hit, at
// `semis` of pitch (playback speed); the plugin wraps positions, so the
// loop simply repeats. The library's loops sit at -20 dB RMS; +12 dB
// brings them near the generators.
// A loop's read position: a random start per hit (from the seed), then
// playing at semis' speed.
loopPosition(seed, semis, t) = (seed * 1000003 : ma.frac) * 1048576 + t * sl.sampleRate * ds.exp2(semis / 12);
loopAt(k, position) = sl.readLoop(k, position) * 4;

// Bit and sample-rate reduction on one knob (0 = clean).
// (Off below a hair: smoothing approaches 0 but, in floats, may never reach it.)
crush(amount, x) = select2(amount > 1e-4, x, x : ba.sAndH(ds.tick(rate)) : ds.quantize(bits))
with {
    c    = ds.clamp(0, 1, amount);
    rate = ma.SR / (1 + 23 * c * c);
    bits = 16 - 12 * c;
};

// Density 1 is continuous; below it, the noise breaks into short random
// grains (30 Hz .. 20 kHz of them), crossing back to continuous near the top.
density(amount, x) = x * ((1 - open) * grains + open)
with {
    d     = ds.clamp(0, 1, amount);
    rate  = 30 * pow(666, d);
    hit   = (no.noises(2, 1) + 1) / 2 < rate / ma.SR;
    grains = hit : max ~ *(exp(-1 / (0.0008 * ma.SR)));
    open  = ds.clamp(0, 1, (d - 0.85) / 0.15);
};

// Clap: the hit becomes `count` short bursts `gap` seconds apart, and the
// envelope proper starts with the last one. amount 0 = a single hit.
//   returns: 1 while the lead-in bursts play, the bursts' own level,
//   and the time the envelope proper should see
clap(amount, t) = t < lead, burst, max(0, t - lead)
with {
    c     = ds.clamp(0, 1, amount);
    count = 1 + floor(c * 4 + 0.5);
    gap   = 0.006 + 0.010 * c;
    lead  = (count - 1) * gap;
    burst = exp(ma.frac(t / gap) * 2.5 / -1);           // each burst falls ~22 dB before the next
                                                        // (Faust reads "-ma.x" as "(0 - ma).x")
};

// Bandpass into a 2-pole highpass. Q 0 is flat: only the highpass acts.
// Turning Q up fades in four gentle bandpass stages one after another, so
// the skirts steepen evenly, 6 dB/oct per quarter of the knob, to
// 24 dB/oct; each stage is broad (Q 0.9), so it narrows without ever
// ringing. Makeup gain holds the level roughly steady as the band narrows.
bpStage(hz, a) = _ <: *(1 - a), (ds.svf(hz, 0.9, 0) : !, *(1 / 0.9), ! : *(a)) :> _;
// Bite (after the 606 hats in D16's Nithonat, Nov 2026): the noise's own
// envelope sets how hard it is driven into a lopsided transistor curve, so a
// hit is rectified and gritty at its peak and comes clean as it decays: the
// timbre follows the envelope, not only the level. The curve saturates
// upward (1 - e^-u) and stays linear downward. A little of the envelope
// itself bleeds through, as a VCA's control does; the noise filter's
// highpass turns that into a tick at the hit. `env` is the envelope with
// velocity (so harder hits bite harder); the caller applies the part level.
BITE_DRIVE = 40;                                        // +32 dB at the top
BITE_BLEED = 0.2;
bite(amount, env, x) = (min(u, 0) + 1 - exp(0 - max(u, 0))) / drive * makeup + BITE_BLEED * b * e
with {
    b = ds.clamp(0, 1, amount);
    e = max(0, env);
    drive = 1 + (BITE_DRIVE - 1) * b * b;
    u = drive * e * x;
    // Makes up what the curve squashes, only as loud as the envelope is
    // (the tail, being clean, needs none). Measured: the hit's start stays
    // within a dB or so of the clean one's.
    makeup = 1 + BITE_MAKEUP * b * min(1, e);
};
BITE_MAKEUP = 0.75;
BITE_OFF = 1e-4;

// The whole Noise layer after its controls: the generated source and the
// loop (blended), crush, density, the filter, at `level`. With Bite on, the
// envelope goes in before the filter (inside the curve) and only the part
// level (partLevel) after it; off, that path isn't computed. The plugin runs it
// as its own DSP (plugin-noise.dsp), only while it sounds: the voice works
// out every input below (envelopes, sweeps, rings) and passes them in.
noiseLayer(kind, toneHz, bpHz, loopIndex, loopPos, blend, crushAmount, densityAmount, q, hpHz, biteAmount, env, partLevel, spread, spreadOn, level) =
    (cos(blend * ma.PI / 2) * generated(kind, 2 * bpHz, toneHz, spread, spreadOn) + sin(blend * ma.PI / 2) * loopAt(loopIndex, loopPos))
    : crush(crushAmount) : density(densityAmount)
    <: enable(filtered * level, biteAmount <= BITE_OFF),
       enable(bite(biteAmount, env) : filtered * partLevel, biteAmount > BITE_OFF) :> _
with { filtered = noiseFilter(ds.clamp(20, 0.45 * ma.SR, bpHz), q, hpHz); };

noiseFilter(bpHz, q, hpHz) = seq(i, 4, bpStage(bpHz, ds.clamp(0, 1, 4 * q - i)))
                           : *(ba.db2linear(12 * pow(ds.clamp(0, 1, q), 0.35) - 4.4))   // fitted at 2.5 kHz;
                                                        // -4.4 dB keeps the layer at its earlier level
                           : fi.highpass(2, ds.clamp(20, 0.45 * ma.SR, hpHz));

//--------------------------------------------------------------------------
// 5. Hits
//    Sample n of set s (Sample numbers wrap within the set) at `semis` of
//    pitch, at full level, fading out over the last 40 % of `decay` (so a
//    long decay plays the whole hit). DC-blocked: some thumps carry DC.
//--------------------------------------------------------------------------

hit(s, n, semis, decay, t) = sl.readHit(sl.hitIndex(s, n), t * sl.sampleRate * ds.exp2(semis / 12)) * fade : fi.dcblocker
with {
    d    = max(0.005, decay);
    fade = ds.clamp(0, 1, (d - t) / (0.4 * d));
};
